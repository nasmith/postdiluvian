{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasmith.github.io/postdiluvian/schema/collection.schema.json",
  "title": "Postdiluvian collection",
  "type": "object",
  "required": ["meta", "ingredients", "cocktails"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "postdiluvian-collection" },
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(\\.\\d+)?$" },
        "contentHash": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
    "cocktails": { "type": "array", "items": { "$ref": "#/$defs/cocktail" } }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["spirit", "vermouth", "fortified", "wine", "liqueur", "amaro", "bitters", "juice", "syrup", "other"] },
        "family": { "enum": ["gin", "whiskey", "rum", "agave", "brandy", "vodka", "aquavit", "other", null] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "brands": { "type": "array", "items": { "type": "string" } },
        "pantry": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "cocktail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "base", "method", "glass", "ingredients"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "aka": { "type": "array", "items": { "type": "string" } },
        "variantOf": { "type": ["string", "null"] },
        "status": { "enum": ["active", "wishlist"] },
        "base": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "method": { "enum": ["shake", "dry-shake", "stir", "build", "swizzle", "blend", "throw"] },
        "glass": { "enum": ["coupe", "old-fashioned", "rocks", "nick-and-nora", "flute", "collins", "highball", "wine"] },
        "service": { "enum": ["up", "rocks", "long", "neat"] },
        "ice": { "enum": ["none", "large-cube", "cubed", "crushed"] },
        "garnish": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "book": { "type": "string" },
            "author": { "type": "string" },
            "url": { "type": "string" },
            "page": { "type": ["integer", "null"] },
            "note": { "type": "string" }
          }
        },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredientUse" } },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingredientUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "ml": { "type": "number", "exclusiveMinimum": 0 },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["dash", "drops", "tsp", "barspoon", "piece", "rinse", "top", "leaves", "sprig"] },
        "approx": { "enum": ["max", "min"] },
        "brand": { "type": "string" },
        "note": { "type": "string" },
        "optional": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["ml"] }, { "required": ["amount"] }, { "required": ["unit"] }]
    }
  }
}
