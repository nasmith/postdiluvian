        },
        {
          "ref": "angostura-bitters",
          "amount": 2,
          "unit": "dash"
        }
      ],
      "steps": [
        "Stir whiskey, syrup, and bitters with ice until well chilled.",
        "Strain over one large cube in a rocks glass.",
        "Express a lemon or orange twist over the top and drop it in."
